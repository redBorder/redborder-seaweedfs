[Unit]
Description=Redborder SeaweedFS master (cluster topology and volume ids)
Documentation=https://github.com/seaweedfs/seaweedfs/wiki
Wants=network-online.target
After=network-online.target
# The options are written by the cookbook seaweedfs: the unit does not start until then
ConditionPathExists=/etc/default/seaweedfs-master

[Service]
Type=simple
User=seaweedfs
Group=seaweedfs
EnvironmentFile=/etc/default/seaweedfs-master
WorkingDirectory=/var/lib/seaweedfs/master
ExecStart=/usr/bin/weed -logtostderr=true master $OPTIONS
Restart=on-failure
RestartSec=5
LimitNOFILE=65536
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/seaweedfs

[Install]
WantedBy=multi-user.target
